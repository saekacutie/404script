# saeka-tg-bot — configuration
# Copy this file to .env and fill in your values. Never commit .env.

# Telegram Bot Token (get it from @BotFather) — REQUIRED
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# GCP Project ID — optional. If unset, the bot extracts it from the fallback link
# you send (e.g. qwiklabs-gcp-02-ba14c59b5455). Only set this if you skip the link.
GCP_PROJECT_ID=

# Default GCP region for deployments
GCP_REGION=us-central1

# Absolute path to the 404script repo (contains deploy.sh, proxies/, common/)
REPO_DIR=/workspace/app

# Optional: comma-separated list of allowed Telegram user IDs.
# If empty, ANY user can use the bot. Set this to lock it down.
ADMIN_IDS=
