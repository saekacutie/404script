# saeka-tg-bot — configuration
# Edit these values. BOT_TOKEN and GCP_PROJECT_ID are required.

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=8445173312:AAGXckAV7J8mb8yhSYW28fgtLoxW6j1qDbg

# GCP Project ID — optional. Extracted from the fallback link (qwiklabs-gcp-...).
# Only set this if you skip the link / don't send one.
GCP_PROJECT_ID=

# Default GCP region for deployments
GCP_REGION=us-central1

# Absolute path to the 404script repo (contains deploy.sh, proxies/, common/)
REPO_DIR=/workspace/app

# Optional: comma-separated list of allowed Telegram user IDs.
# If empty, ANY user can use the bot. Set this to lock it down.
ADMIN_IDS=
